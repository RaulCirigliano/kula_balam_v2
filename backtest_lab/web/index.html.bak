<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kula Balam // Backtest Lab Pro</title>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0b0f19;
      --bg-card: #131b2e;
      --bg-input: #080c14;
      --border: #23324d;
      --border-focus: #3b82f6;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --green: #10b981;
      --green-hover: #059669;
      --blue: #2563eb;
      --blue-hover: #1d4ed8;
      --amber: #f59e0b;
      --cyan: #06b6d4;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg-dark);
      color: var(--text);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      padding: 10px 14px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 10px;
      flex-shrink: 0;
    }

    .brand {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }

    .brand h1 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--green);
    }

    .brand span {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .badge {
      font-size: 0.72rem;
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
      padding: 3px 8px;
      border-radius: 9999px;
      border: 1px solid rgba(16, 185, 129, 0.25);
      font-weight: 600;
    }

    .controls-container {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex-shrink: 0;
    }

    .control-line {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      width: 100%;
    }

    .field-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex: 1 1 auto;
      min-width: 220px;
    }

    label {
      font-size: 0.78rem;
      font-weight: 600;
      white-space: nowrap;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .lbl-data { color: var(--cyan); }
    .lbl-hist { color: var(--amber); }
    .lbl-saved { color: #60a5fa; }

    select, input {
      background: var(--bg-input);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.84rem;
      font-family: inherit;
      outline: none;
      width: 100%;
      min-width: 0;
      transition: border-color 0.2s;
    }

    select:focus, input:focus { border-color: var(--border-focus); }
    select { cursor: pointer; text-overflow: ellipsis; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      white-space: nowrap;
      flex-shrink: 0;
      transition: background 0.15s, transform 0.1s;
    }

    .btn:active { transform: scale(0.97); }
    .btn-green { background: var(--green); color: #022c22; }
    .btn-green:hover { background: var(--green-hover); }
    .btn-blue { background: var(--blue); color: #fff; }
    .btn-blue:hover { background: var(--blue-hover); }

    .btn-dark {
      background: #1e293b;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-dark:hover { background: #334155; }

    .btn-mini {
      padding: 3px 8px;
      font-size: 0.73rem;
      border-radius: 4px;
    }

    .btn-loading {
      opacity: 0.6;
      cursor: not-allowed !important;
      pointer-events: none;
    }

    .workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      flex: 1;
      min-height: 0;
    }

    .panel {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .panel-header {
      padding: 6px 12px;
      background: #0f172a;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
      gap: 8px;
    }

    .panel-title {
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .panel-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    textarea {
      flex: 1;
      border: none;
      padding: 12px;
      font-family: 'Fira Code', Consolas, monospace;
      font-size: 0.85rem;
      line-height: 1.45;
      resize: none;
      outline: none;
      width: 100%;
      height: 100%;
    }

    #codeEditor {
      background: #070b12;
      color: #e2e8f0;
      white-space: pre;
      tab-size: 4;
    }

    #output {
      background: #05080e;
      color: #34d399;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <h1>Kula Balam</h1>
      <span>Laboratorio de Backtest Cuantitativo</span>
    </div>
    <span class="badge">● Servidor Activo</span>
  </header>

  <div class="controls-container">
    <!-- LÍNEA 1: DATASET + ACTUALIZAR + EJECUTAR -->
    <div class="control-line">
      <div class="field-group" style="flex: 2 1 300px;">
        <label class="lbl-data" for="selTicker">Dataset:</label>
        <select id="selTicker"></select>
      </div>
      <button id="btnActualizarVelas" class="btn btn-dark" onclick="actualizarVelasAlDia()" title="Descargar últimas velas al día de hoy">
        🔄 Actualizar Velas
      </button>
      <button id="btnRun" class="btn btn-green" onclick="ejecutarCodigo()">
        ▶ Ejecutar
      </button>
    </div>

    <!-- LÍNEA 2: HISTORIAL AUDITADO + MIS GUARDADAS + COMENTARIO -->
    <div class="control-line">
      <div class="field-group" style="flex: 2 1 240px;">
        <label class="lbl-hist" for="selHistorial">Historial:</label>
        <select id="selHistorial" onchange="cargarDesdeHistorial()">
          <option value="">-- Cargar Auditoría --</option>
        </select>
      </div>

      <div class="field-group" style="flex: 2 1 220px;">
        <label class="lbl-saved" for="selGuardadas">Guardadas:</label>
        <select id="selGuardadas" onchange="cargarDesdeGuardadas()">
          <option value="">-- Mis Fórmulas --</option>
        </select>
      </div>

      <div class="field-group" style="flex: 1 1 130px; min-width: 110px;">
        <input type="text" id="txtNombre" placeholder="archivo.py">
      </div>

      <div class="field-group" style="flex: 2 1 240px; gap: 4px;">
        <input type="text" id="txtComentario" placeholder="Comentario / Nota...">
        <button type="button" class="btn btn-dark" style="padding: 5px 7px;" onclick="insertarEmoji('✅ [POSITIVA] ')" title="Estrategia Ganadora">✅</button>
        <button type="button" class="btn btn-dark" style="padding: 5px 7px;" onclick="insertarEmoji('⚠️ [NEUTRA] ')" title="En Observación">⚠️</button>
        <button type="button" class="btn btn-dark" style="padding: 5px 7px;" onclick="insertarEmoji('❌ [DESCARTADA] ')" title="Pérdida / Descartada">❌</button>
        <button type="button" class="btn btn-dark" style="padding: 5px 7px;" onclick="insertarEmoji('📐 [HERRAMIENTA] ')" title="Herramienta / Auditoría">📐</button>
      </div>

      <button class="btn btn-blue" onclick="guardarMiFormula()">
        💾 Guardar
      </button>
    </div>
  </div>

  <!-- WORKSPACE -->
  <div class="workspace">
    <!-- PANEL EDITOR -->
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">Editor Python (sys.argv[1] contiene la ruta al dataset)</span>
        <div class="panel-actions">
          <button type="button" class="btn btn-dark btn-mini" onclick="pegarEnEditor()" title="Pegar código desde el portapapeles">📋 Pegar</button>
          <button type="button" class="btn btn-dark btn-mini" onclick="borrarEditor()" title="Limpiar todo el editor">🧹 Borrar</button>
        </div>
      </div>
      <textarea id="codeEditor" spellcheck="false" placeholder="# Selecciona una estrategia del historial o escribe tu código aquí..."></textarea>
    </div>

    <!-- PANEL CONSOLA -->
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">Consola de Métricas y Rendimiento</span>
        <div class="panel-actions">
          <button type="button" class="btn btn-dark btn-mini" onclick="copiarConsola()" title="Copiar todo el texto de la consola">📋 Copiar</button>
          <button type="button" class="btn btn-dark btn-mini" onclick="document.getElementById('output').value=''" title="Limpiar la consola">🧹 Limpiar</button>
        </div>
      </div>
      <textarea id="output" readonly spellcheck="false" placeholder="Esperando ejecución..."></textarea>
    </div>
  </div>

  <script>
    // FUNCIONES DE EDICIÓN RÁPIDA (PEGAR, BORRAR, COPIAR)
    async function pegarEnEditor() {
      try {
        const text = await navigator.clipboard.readText();
        const editor = document.getElementById('codeEditor');
        editor.value = text;
        editor.focus();
      } catch (err) {
        // Fallback si los permisos del navegador bloquean readText
        const editor = document.getElementById('codeEditor');
        editor.focus();
        alert('Presioná Ctrl + V para pegar el código en el editor.');
      }
    }

    function borrarEditor() {
      if (document.getElementById('codeEditor').value.trim() !== '') {
        if (true) {
          document.getElementById('codeEditor').value = '';
          document.getElementById('codeEditor').focus();
        }
      }
    }

    async function copiarConsola() {
      const out = document.getElementById('output');
      if (!out.value.trim()) return;
      try {
        await navigator.clipboard.writeText(out.value);
        const originalText = out.value;
        // Indicador momentáneo
        const btn = event.target;
        btn.textContent = '✓ Copiado';
        setTimeout(() => { btn.textContent = '📋 Copiar'; }, 1500);
      } catch (err) {
        out.select();
        document.execCommand('copy');
      }
    }

    function insertarEmoji(emoji) {
      const input = document.getElementById('txtComentario');
      input.value = emoji + input.value.replace(/^[✅⚠️❌📐]\s*\[.*?\]\s*/, '');
      input.focus();
    }

    async function cargarDatasets() {
      const sel = document.getElementById('selTicker');
      try {
        const res = await fetch('/api/datasets');
        const data = await res.json();
        sel.innerHTML = '';
        const lista = data.datos_historicos || [];
        if (lista.length === 0) {
          sel.innerHTML = '<option value="">No hay datasets disponibles</option>';
          return;
        }
        lista.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item;
          opt.textContent = item;
          sel.appendChild(opt);
        });
      } catch (err) {
        sel.innerHTML = '<option value="">Error cargando datasets</option>';
      }
    }

    async function cargarHistorial() {
      const sel = document.getElementById('selHistorial');
      try {
        const res = await fetch('/api/historial');
        const lista = await res.json();
        lista.sort((a, b) => {
          const s = t => t.includes('✅') ? 3 : t.includes('⚠️') ? 2 : t.includes('📐') ? 1 : 0;
          return s(b.comentario || '') - s(a.comentario || '');
        });
        sel.innerHTML = '<option value="">-- Cargar Auditoría --</option>';
        lista.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.nombre;
          opt.textContent = item.comentario ? `${item.comentario} | ${item.nombre}` : `⚪ ${item.nombre}`;
          sel.appendChild(opt);
        });
      } catch (err) {
        console.error(err);
      }
    }

    async function cargarGuardadas() {
      const sel = document.getElementById('selGuardadas');
      try {
        const res = await fetch('/api/estrategias');
        const lista = await res.json();
        sel.innerHTML = '<option value="">-- Mis Fórmulas --</option>';
        lista.forEach(item => {
          const opt = document.createElement('option');
          opt.value = item.nombre;
          opt.textContent = item.comentario ? `${item.nombre} — [${item.comentario}]` : item.nombre;
          sel.appendChild(opt);
        });
      } catch (err) {
        console.error(err);
      }
    }

    async function cargarDesdeHistorial() {
      const sel = document.getElementById('selHistorial');
      if (!sel.value) return;
      try {
        const res = await fetch('/api/historial/' + encodeURIComponent(sel.value));
        const data = await res.json();
        if (data.codigo) {
          document.getElementById('codeEditor').value = data.codigo;
          document.getElementById('txtNombre').value = data.nombre;
          const txt = sel.options[sel.selectedIndex].textContent;
          document.getElementById('txtComentario').value = txt.includes(' | ') ? txt.split(' | ')[0] : '';
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function cargarDesdeGuardadas() {
      const sel = document.getElementById('selGuardadas');
      if (!sel.value) return;
      try {
        const res = await fetch('/api/estrategias/' + encodeURIComponent(sel.value));
        const data = await res.json();
        if (data.codigo) {
          document.getElementById('codeEditor').value = data.codigo;
          document.getElementById('txtNombre').value = data.nombre;
          const txt = sel.options[sel.selectedIndex].textContent;
          const m = txt.match(/— \[(.*)\]$/);
          document.getElementById('txtComentario').value = m ? m[1] : '';
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function guardarMiFormula() {
      const nom = document.getElementById('txtNombre').value.trim();
      const com = document.getElementById('txtComentario').value.trim();
      const cod = document.getElementById('codeEditor').value;
      const out = document.getElementById('output');

      if (!nom) { alert('Ingresá un nombre de archivo (ej: mi_estrategia.py)'); return; }
      if (!cod.trim()) { alert('El editor está vacío.'); return; }

      try {
        const res = await fetch('/api/estrategias/guardar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre: nom, comentario: com, codigo: cod })
        });
        const d = await res.json();
        if (d.status === 'ok') {
          out.value = `✓ GUARDADO EXITOSO:\nArchivo: ${d.archivo}\nNota: ${d.comentario}\nCarpeta: backtest_lab/estrategias/`;
          await cargarGuardadas();
          document.getElementById('selGuardadas').value = d.archivo;
        } else {
          alert('Error: ' + JSON.stringify(d));
        }
      } catch (err) {
        alert('Error al guardar: ' + err.message);
      }
    }

    async function actualizarVelasAlDia() {
      const btn = document.getElementById('btnActualizarVelas');
      const out = document.getElementById('output');
      btn.classList.add('btn-loading');
      btn.textContent = '⏳ Descargando...';
      out.value = '>>> Conectando con Yahoo Finance y Binance...\nDescargando velas recientes al día de hoy...\n(Por favor espera unos segundos)...';

      try {
        const res = await fetch('/api/datasets/actualizar', { method: 'POST' });
        const d = await res.json();
        if (d.status === 'ok') {
          out.value = '✓ ACTUALIZACIÓN COMPLETADA:\n\n' + d.log;
          await cargarDatasets();
        } else {
          out.value = 'Error al actualizar: ' + JSON.stringify(d);
        }
      } catch (err) {
        out.value = 'Error de conexión: ' + err.message;
      } finally {
        btn.classList.remove('btn-loading');
        btn.textContent = '🔄 Actualizar Velas';
      }
    }

    async function ejecutarCodigo() {
      const tick = document.getElementById('selTicker').value;
      const cod = document.getElementById('codeEditor').value;
      const out = document.getElementById('output');
      const btn = document.getElementById('btnRun');

      if (!tick) { alert('Selecciona un dataset primero.'); return; }
      if (!cod.trim()) { alert('El editor está vacío.'); return; }

      btn.classList.add('btn-loading');
      btn.textContent = '⏳ Calculando...';
      out.value = `>>> Ejecutando simulación sobre ${tick}...\n`;

      try {
        const res = await fetch('/api/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category: 'datos_historicos', ticker: tick, code: cod })
        });
        const d = await res.json();
        let resTxt = '';
        if (d.output) resTxt += d.output;
        if (d.error) resTxt += '\n--- ERRORES / ALERTAS ---\n' + d.error;
        out.value = resTxt.trim() ? resTxt : 'El script terminó sin imprimir texto.';
      } catch (err) {
        out.value = 'Error de comunicación: ' + err.message;
      } finally {
        btn.classList.remove('btn-loading');
        btn.textContent = '▶ Ejecutar';
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      cargarDatasets();
      cargarHistorial();
      cargarGuardadas();
    });
  </script>
</body>
</html>
